# Kopie als .env anlegen. .env wird nie eingecheckt.

# --- App (öffentlich, landet im App-Paket) ---
# Supabase > Project Settings > API: Project URL und anon/publishable key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat > Project > API keys: öffentliche App-Schlüssel (appl_… und goog_…)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Nur für die KI-Pipeline auf deinem Rechner (geheim) ---
# Wird nicht ins App-Paket übernommen, weil der Name nicht mit EXPO_PUBLIC_ beginnt.
ANTHROPIC_API_KEY=
